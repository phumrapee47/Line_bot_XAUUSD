# Database Configuration (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# LINE Messaging API Configuration
# ตัวเลือก 1: Broadcast (ส่งให้ทุกคนในช่อง) - Default
LINE_CHANNEL_ACCESS_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET_HERE
# USE_BROADCAST=true

# ตัวเลือก 2: Push (ส่งไปเฉพาะคนหนึ่ง) - Optional
# LINE_USER_ID=your_user_id_here
# USE_BROADCAST=false

# Model Configuration
TECHNICAL_WEIGHT=0.6
NEWS_WEIGHT=0.4
TECHNICAL_MODEL_PATH=./ml-models/gold_ml_model_selected.pkl

# Trading Configuration
BUY_THRESHOLD=0.60
SELL_THRESHOLD=0.40

# Scheduler Configuration
CHECK_INTERVAL_MINUTES=60

# Server Configuration
PORT=3000
NODE_ENV=development

# News Configuration
NEWS_RSS_URL=https://www.fxstreet.com/rss/news

